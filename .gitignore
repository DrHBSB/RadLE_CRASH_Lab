# Python / notebook runtime noise
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Local environments
.env
*.env
.venv/
venv/

# RadLE data and generated outputs stay in Google Drive.
data/
datasets/
outputs/
results/
artifacts/
*.csv
*.xlsx
*.jsonl

